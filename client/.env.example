# ==============================================================================
# P-Omegle Frontend Environment Variables Template (client/.env.example)
# Copy this file to `client/.env` (for dev) or configure in Vercel/Netlify dashboard.
# ==============================================================================

# VITE_SERVER_URL: Base HTTP URL of the backend REST API
# Local dev: http://localhost:5000
# Production: https://omegle-backend-r1e4.onrender.com (or your custom backend URL)
VITE_SERVER_URL=http://localhost:5000

# VITE_WS_URL: Base WebSocket URL of the backend signaling server
# Local dev: ws://localhost:5000/ws
# Production: wss://omegle-backend-r1e4.onrender.com/ws (or your custom backend WSS URL)
VITE_WS_URL=ws://localhost:5000/ws
