# ==============================================================================
# P-Omegle Backend Environment Variables Template (server/.env.example)
# Copy this file to `server/.env` and update the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK
# ------------------------------------------------------------------------------
# PORT: The port number the Express & WebSocket server listens on.
# Default: 5000 (Render automatically assigns PORT in production)
PORT=5000

# HOST: The network interface to bind to.
# Default: 0.0.0.0 (listens on all network interfaces)
HOST=0.0.0.0

# NODE_ENV: Application environment mode (development | production | test)
NODE_ENV=development


# ------------------------------------------------------------------------------
# 2. CORS & ALLOWED ORIGINS
# ------------------------------------------------------------------------------
# CLIENT_ORIGIN: The primary frontend client URL.
# Local dev: http://localhost:5173
# Production example: https://your-frontend.vercel.app
CLIENT_ORIGIN=http://localhost:5173

# ALLOWED_ORIGINS: Comma-separated list of allowed frontend domains.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://yourdomain.com


# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# JWT_SECRET: Secret key used to sign anonymous user session tokens.
# Generate a strong, unique 64+ char random string in production!
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# JWT_EXPIRES_IN: Lifespan of the session JWT access token (e.g. 15m, 1h, 24h, 7d).
JWT_EXPIRES_IN=24h

# REFRESH_TOKEN_SECRET: Secret key used to sign refresh tokens.
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_change_in_production

# REFRESH_TOKEN_EXPIRES_IN: Lifespan of the refresh token (e.g. 7d, 14d, 30d).
REFRESH_TOKEN_EXPIRES_IN=7d


# ------------------------------------------------------------------------------
# 4. MATCHMAKING ENGINE SETTINGS
# ------------------------------------------------------------------------------
# MATCHMAKING_INTEREST_TIMEOUT_MS: Maximum time in ms to wait for an exact interest
# match before falling back to any random user. Default: 5000 (5 seconds)
MATCHMAKING_INTEREST_TIMEOUT_MS=5000

# MATCHMAKING_COOLDOWN_MS: Cooldown in ms before matched users can pair again.
# Default: 15000 (15 seconds)
MATCHMAKING_COOLDOWN_MS=15000

# SESSION_GRACE_PERIOD_MS: Reconnect grace period in ms before room cleanup.
# Default: 15000 (15 seconds)
SESSION_GRACE_PERIOD_MS=15000

# HEARTBEAT_INTERVAL_MS: Interval in ms between WebSocket ping/pong heartbeats.
# Default: 10000 (10 seconds)
HEARTBEAT_INTERVAL_MS=10000


# ------------------------------------------------------------------------------
# 5. API RATE LIMITING (DDoS & Spam Protection)
# ------------------------------------------------------------------------------
# RATE_LIMIT_WINDOW_MS: Rate limit window in ms. Default: 60000 (1 minute)
RATE_LIMIT_WINDOW_MS=60000

# RATE_LIMIT_MAX_REQUESTS: Maximum HTTP requests allowed per IP per window.
# Default: 120
RATE_LIMIT_MAX_REQUESTS=120


# ------------------------------------------------------------------------------
# 6. WEBRTC STUN / TURN SERVERS (Video & Audio P2P Traversal)
# ------------------------------------------------------------------------------
# STUN_SERVERS: Comma-separated list of STUN servers for NAT discovery.
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN_SERVER_URL: Optional TURN server URL for symmetric NAT traversal.
TURN_SERVER_URL=

# TURN_SERVER_USERNAME: Username for TURN server authentication.
TURN_SERVER_USERNAME=

# TURN_SERVER_CREDENTIAL: Password/credential for TURN server authentication.
TURN_SERVER_CREDENTIAL=


# ------------------------------------------------------------------------------
# 7. OPTIONAL STORAGE & CACHING (Docker / Scaled Deployments)
# ------------------------------------------------------------------------------
# Optional: Redis connection URL for multi-node deployments
# REDIS_URL=redis://localhost:6379

# Optional: PostgreSQL connection URL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omegle_db
